# Byte-compiled / cache files
__pycache__/
.pytest_cache/
*.pyc

# Java / JDBC Drivers
*.jar
cleaning/drivers/

# Hadoop runtime folders
winutils.exe
hadoop.dll

# Raw data (do not track full source CSVs)
data/raw/*
