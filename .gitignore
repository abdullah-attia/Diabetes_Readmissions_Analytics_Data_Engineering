# Virtual environments
.venv/
.venv-dbt/

# Secrets (never commit)
.env
airflow/.env
set_env.ps1
keys/
*.p8

# Byte-compiled / cache files
__pycache__/
.pytest_cache/
*.pyc

# Java / JDBC Drivers
*.jar
cleaning/drivers/

# Hadoop binaries
winutils.exe
hadoop.dll

# Raw data (download from UCI, dataset id 296)
data/raw/*
!data/raw/.gitkeep

# Processed data (regenerated by the pipeline)
data/processed/*
!data/processed/.gitkeep

# Sample data (tracked, so teammates can develop without the full data)
!data/sample/**

# dbt build artifacts
warehouse/dbt_project/target/
warehouse/dbt_project/dbt_packages/
warehouse/dbt_project/logs/

# Airflow runtime files
airflow/logs/
airflow/plugins/__pycache__/

# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
.DS_Storewarehouse/dbt_project/.user.yml

# Visual Studio / SSIS build files
ingestion/**/.vs/
ingestion/**/bin/
ingestion/**/obj/
ingestion/**/UpgradeLog*.htm
